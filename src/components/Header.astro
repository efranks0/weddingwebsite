---
import { site } from '../content/site';
const links = [
  ['#cover', site.hero.menuLabel],
  ['#the-day', site.day.title],
  ['#dress-code', site.dressCode.title],
  ['#album', site.album.title],
  ['#faq', site.faq.title],
  ['#rsvp', site.rsvp.title],
];
---
<header class="header" id="site-header">
  <a class="header__logo t-label" href="#cover">{site.logo}</a>
  <nav class="header__nav" aria-label="Main">
    <a class="header__link t-label" href="#rsvp">RSVP</a>
    <button class="header__link t-label" type="button" aria-expanded="false" aria-controls="menu" id="menu-toggle">Menu</button>
  </nav>
</header>
<div class="menu" id="menu" hidden>
  <ul>
    {links.map(([href, label]) => <li><a class="menu__link t-h2" href={href}>{label}</a></li>)}
  </ul>
</div>
<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('menu')!;
  const header = document.getElementById('site-header')!;
  const cover = document.getElementById('cover');
  const update = () => header.classList.toggle('is-over', !!cover && menu.hidden && window.scrollY < cover.offsetHeight - header.offsetHeight);
  const set = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Close' : 'Menu';
    update();
  };
  toggle.addEventListener('click', () => set(menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
</script>

---
import { site } from '../content/site';
const a = site.album;
---
<section class="section" id="album">
  <div class="container">
    <h2>{a.title}</h2>
    {a.paragraphs.map((p) => <p>{p}</p>)}
    {a.qrImage && <img class="album__qr" src={a.qrImage} alt="QR code for the photo album" width="180" height="180" />}
    {a.url && <a class="button" href={a.url} target="_blank" rel="noopener">{a.button}</a>}
  </div>
</section>

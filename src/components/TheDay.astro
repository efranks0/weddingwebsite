---
// Public mode renders only public blocks. Personal mode renders everything
// tagged with data-show; the /i/<token> function strips what this household
// isn't invited to before the page leaves the server.
import { site } from '../content/site';
interface Props { personal?: boolean }
const { personal = false } = Astro.props;
const blocks = personal ? site.day.blocks : site.day.blocks.filter((b) => b.public);
const show = (s: string) => (personal && s ? s : undefined);
---
<section class="day" id="the-day" aria-label={site.day.title}>
  <div class="container">
    {blocks.map((b) => (
      <div class="day__block" data-show={show(b.show)}>
        <h2 class="day__title t-h2">{b.title}</h2>
        {b.entries.map((e) => (
          <div class="day__entry" data-show={show(e.show)}>
            <p class="day__time t-label">{e.time}</p>
            {e.lines.map((l) => <p class="t-body">{l}</p>)}
            {e.map && <a class="button t-label" href={e.map} target="_blank" rel="noopener">{site.day.locationButton}</a>}
          </div>
        ))}
        {b.footer.length > 0 && <div class="day__footer">{b.footer.map((l) => <p class="t-body">{l}</p>)}</div>}
        {b.map && <a class="button t-label" href={b.map} target="_blank" rel="noopener">{site.day.locationButton}</a>}
      </div>
    ))}
  </div>
</section>

---
import { site } from '../content/site';
interface Props { personal?: boolean }
const { personal = false } = Astro.props;
---
<section class="hero" id="top">
  {site.artwork.hero && <img class="hero__art" src={site.artwork.hero} alt={site.artwork.heroAlt} />}
  {personal && <p class="hero__greeting t-label">{site.rsvp.greeting} <span data-slot="household-name"></span></p>}
  <h2 class="hero__title t-h1">{site.hero.title}</h2>
  <p class="hero__date t-label">{site.hero.date}</p>
  {site.hero.lines.map((l) => <p class="t-body">{l}</p>)}
</section>

---
const links = [
  ['#dress-code', 'Dress Code'],
  ['#the-day', 'The Day'],
  ['#album', 'Photos'],
  ['#faq', 'FAQ'],
  ['#rsvp', 'RSVP'],
];
---
<nav class="nav" aria-label="Sections">
  <ul class="nav__list">
    {links.map(([href, label]) => <li><a class="nav__link" href={href}>{label}</a></li>)}
  </ul>
</nav>

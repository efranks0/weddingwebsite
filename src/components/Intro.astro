---
import { site } from '../content/site';
const { title, paragraphs } = site.intro;
---
{(title || paragraphs.length > 0) && (
  <section class="section" id="intro">
    <div class="container">
      {title && <h2 class="section__title t-h2">{title}</h2>}
      {paragraphs.map((p) => <p class="t-body">{p}</p>)}
    </div>
  </section>
)}

---
// Plain, functional layout for screens the designer does NOT design:
// password screen, admin login, admin dashboard (incl. WhatsApp Send tab), 404.
// Deliberately independent of the guest design system (tokens.css etc.),
// so restyling the guest site never changes these.
import '../styles/plain.css';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="plain">
    <slot />
  </body>
</html>

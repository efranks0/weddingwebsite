---
import Base from '../layouts/Base.astro';
import { site } from '../content/site';
---
<Base title={`Not found · ${site.title}`}>
  <header class="header"><span class="logo">{site.logo}</span></header>
  <main class="auth">
    <div class="auth__card">
      <h1>{site.couple}</h1>
      <p>We couldn’t find this page. If you followed your personal link, please check it was copied in full, or message us.</p>
    </div>
  </main>
</Base>

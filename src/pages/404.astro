---
import Plain from '../layouts/Plain.astro';
import { site } from '../content/site';
---
<Plain title={`Not found · ${site.title}`}>
  <main class="p-center">
    <div class="p-card">
      <h1>{site.couple}</h1>
      <p>We couldn’t find this page. If you followed your personal link, please check it was copied in full, or message us.</p>
    </div>
  </main>
</Plain>

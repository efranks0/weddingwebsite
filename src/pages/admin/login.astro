---
import Plain from '../../layouts/Plain.astro';
---
<Plain title="Admin">
  <main class="p-center">
    <form class="p-card" method="post" action="/api/admin/login">
      <h1>Admin</h1>
      <p id="login-error" class="p-error" hidden>Wrong password.</p>
      <label class="p-field">
        <span class="p-label">Password</span>
        <input class="p-input" type="password" name="password" autocomplete="current-password" required autofocus />
      </label>
      <button class="p-button" type="submit">Sign in</button>
    </form>
  </main>
  <script>
    if (new URLSearchParams(location.search).get('error')) document.getElementById('login-error')!.hidden = false;
  </script>
</Plain>

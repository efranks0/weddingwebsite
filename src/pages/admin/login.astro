---
import Base from '../../layouts/Base.astro';
---
<Base title="Admin">
  <main class="auth">
    <form class="auth__card" method="post" action="/api/admin/login">
      <h1>Admin</h1>
      <p id="login-error" class="notice notice--error" hidden>Wrong password.</p>
      <label class="field">
        <span class="field__label">Password</span>
        <input class="input" type="password" name="password" autocomplete="current-password" required autofocus />
      </label>
      <button class="button" type="submit">Sign in</button>
    </form>
  </main>
  <script>
    if (new URLSearchParams(location.search).get('error')) document.getElementById('login-error')!.hidden = false;
  </script>
</Base>

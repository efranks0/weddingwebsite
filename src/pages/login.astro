---
// Shared password screen for the public front page. Plain by design
// (not part of the Figma); guests with a personal link never see it.
import Plain from '../layouts/Plain.astro';
import { site } from '../content/site';
---
<Plain title={site.title}>
  <main class="p-center">
    <form class="p-card" method="post" action="/api/login">
      <h1>{site.couple}</h1>
      <p id="login-error" class="p-error" hidden>That password didn’t work. Please try again.</p>
      <label class="p-field">
        <span class="p-label">Password</span>
        <input class="p-input" type="password" name="password" autocomplete="current-password" required autofocus />
      </label>
      <input type="hidden" name="next" value="/" />
      <button class="p-button" type="submit">Enter</button>
    </form>
  </main>
  <script>
    const q = new URLSearchParams(location.search);
    if (q.get('error')) document.getElementById('login-error')!.hidden = false;
    const next = q.get('next');
    if (next) (document.querySelector('input[name=next]') as HTMLInputElement).value = next;
  </script>
</Plain>

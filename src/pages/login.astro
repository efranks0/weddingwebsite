---
import Base from '../layouts/Base.astro';
import { site } from '../content/site';
---
<Base>
  <main class="auth">
    <form class="auth__card" method="post" action="/api/login">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1>{site.couple}</h1>
      <p id="login-error" class="notice notice--error" hidden>That password didn’t work. Please try again.</p>
      <label class="field">
        <span class="field__label">Password</span>
        <input class="input" type="password" name="password" autocomplete="current-password" required autofocus />
      </label>
      <input type="hidden" name="next" value="/" />
      <button class="button" type="submit">Enter</button>
    </form>
  </main>
  <script>
    const q = new URLSearchParams(location.search);
    if (q.get('error')) document.getElementById('login-error')!.hidden = false;
    const next = q.get('next');
    if (next) (document.querySelector('input[name=next]') as HTMLInputElement).value = next;
  </script>
</Base>
